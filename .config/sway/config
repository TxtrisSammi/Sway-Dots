# Default config for sway
#
# Copy this to ~/.config/sway/config and edit it to your liking.
#
# Read `man 5 sway` for a complete reference.

### Variables
#
# Logo key. Use Mod1 for Alt.
set $mod Mod4
# Home row direction keys, like vim
set $left h
set $down j
set $up k
set $right l

# Variables
set $term kitty
set $menu rofi -show drun
set $browser firefox

# Wallpaper (hardcoded for now)
exec awww-daemon & awww img ~/Pictures/wallpapers/Coffee-1.png
# Status Bar:
exec waybar

### Border rules
default_border pixel 2
default_floating_border pixel 2
client.focused #000000 #000000 #000000 #000000 #655966

### Input configuration
input type:touchpad {
	 dwt enabled
	 tap enabled
	 natural_scroll enabled
	 middle_emulation enabled
}

input type:keyboard {
	 xkb_layout "eu"
}

include /etc/sway/config.d/*
include /home/txtrissammi/.config/sway/config.d/*
